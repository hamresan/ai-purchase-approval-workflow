APP_ENV=development

POSTGRES_DB=ai_purchase_workflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5632
POSTGRES_CONTAINER_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_purchase_workflow
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5632/ai_purchase_workflow
FRONTEND_ORIGIN=http://localhost:5173

# Identity secrets must be replaced with strong independent values outside development.
IDENTITY_SIGNING_SECRET=development-identity-signing-secret
IDENTITY_JWT_SIGNING_SECRET=development-jwt-signing-secret-change-me
IDENTITY_ACCESS_TOKEN_MINUTES=15

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Model provider: fake | ollama | openai | openrouter\n# Fake is for development/tests/CI and is rejected when APP_ENV=production.
WORKFLOW_MODEL_PROVIDER=fake
WORKFLOW_MODEL_NAME=qwen3:8b
WORKFLOW_MODEL_BASE_URL=
WORKFLOW_MODEL_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENROUTER_API_KEY=
